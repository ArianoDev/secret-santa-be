# Host port published by Compose; the backend listens on port 4000 internally.
PORT=4000

# Set this to the exact frontend origin in production.
CORS_ORIGIN=http://localhost:3000

# Use URL-safe database names and credentials (letters, digits, underscores).
# Replace this example password before deployment, e.g. with: openssl rand -hex 32
POSTGRES_DB=secret_santa
POSTGRES_USER=secret_santa
POSTGRES_PASSWORD=replace_with_a_random_hex_password

# Only needed when running the backend outside Compose.
# Compose builds DATABASE_URL from the POSTGRES_* values, using host "postgres".
DATABASE_URL=postgresql://secret_santa:replace_with_a_random_hex_password@localhost:5432/secret_santa
